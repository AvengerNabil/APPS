<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:background="@drawable/bg_card_rounded"
    android:foreground="?android:attr/selectableItemBackground"
    android:padding="12dp">

    <ImageView
        android:id="@+id/img_folder"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_folder"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/primary" />

    <TextView
        android:id="@+id/txt_name"
        style="@style/TextStyle"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:singleLine="true"
        android:textColor="@color/white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/txt_total_videos"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_folder"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Download" />

    <TextView
        android:id="@+id/txt_total_videos"
        style="@style/TextStyle.Grey"
        android:layout_marginStart="14dp"
        android:layout_marginTop="2dp"
        android:singleLine="true"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/img_folder"
        app:layout_constraintTop_toBottomOf="@id/txt_name"
        tools:text="12 videos" />

</androidx.constraintlayout.widget.ConstraintLayout>
